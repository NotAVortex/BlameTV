{
  "name": "blametv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "setup": "prisma db push --schema prisma/schema.local.prisma",
    "db:push": "prisma db push --schema prisma/schema.local.prisma",
    "db:push:prod": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "postinstall": "prisma generate --schema prisma/schema.local.prisma",
    "generate:local": "prisma generate --schema prisma/schema.local.prisma",
    "db:generate": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
